.fs-display-2xl {
    @include fs-display-2xl;
}

.fs-display-xl {
    @include fs-display-xl;
}

.fs-display-lg {
    @include fs-display-lg;
}

.fs-display-md {
    @include fs-display-md;
}

.fs-display-sm {
    @include fs-display-sm;
}

.fs-display-xs {
    @include fs-display-xs;
}

.fs-xl {
    @include fs-xl;
}

.fs-lg {
    @include fs-lg;
}

.fs-md {
    @include fs-md;
}

.fs-sm {
    @include fs-sm;
}

.fs-xs {
    @include fs-xs;
}

.fs-2xs {
    @include fs-2xs;
}

@mixin fs-display-2xl {
    font-size: 4.5rem;
    line-height: 5.625rem;
    letter-spacing: -2%;
}

@mixin fs-display-xl {
    font-size: 3.75rem;
    line-height: 4.5rem;
    letter-spacing: -2%;
}

@mixin fs-display-lg {
    font-size: 3rem;
    line-height: 3.75rem;
    letter-spacing: -2%;
}

@mixin fs-display-md {
    font-size: 2.25rem;
    line-height: 2.75rem;
    letter-spacing: -2%;
}

@mixin fs-display-sm {
    font-size: 1.875rem;
    line-height: 2.375rem;
}

@mixin fs-display-xs {
    font-size: 1.5rem;
    line-height: 2rem;
}

@mixin fs-xl {
    font-size: 1.25rem;
    line-height: 1.875rem;
}

@mixin fs-lg {
    font-size: 1.125rem;
    line-height: 1.75rem;
}

@mixin fs-md {
    font-size: 1rem;
    line-height: 1.5rem;
}

@mixin fs-sm {
    font-size: 0.875rem;
    line-height: 1.25rem;
}

@mixin fs-xs {
    font-size: 0.75rem;
    line-height: 1.125rem;
}

@mixin fs-2xs {
    font-size: 0.625rem;
    line-height: 0.875rem;
}
